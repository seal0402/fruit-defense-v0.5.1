; Godot .NET 4.7.2 / C# prototype
config_version=5

[application]
config/name="保卫水果 · 弹射防线"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/size/min_width=360
window/size/min_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]
pointing/emulate_mouse_from_touch=true

[dotnet]
project/assembly_name="FruitDefense"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.055, 0.065, 1)

[physics]
common/physics_ticks_per_second=120
